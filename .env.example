# Server-only SMTP configuration for the contact form.
# Copy to .env.local and replace every placeholder with verified values.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Fiysam Studio <no-reply@your-verified-domain.example>"
CONTACT_TO=your-verified-inbox@example.com
